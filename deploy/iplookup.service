# systemd unit for iplookup. Install as /etc/systemd/system/iplookup.service
# (see deploy/README.md). Logs go to the journal: journalctl -u iplookup
#
# Reload story: new Data Source files are swapped in by the app itself and a
# new web build is picked up on the next page request, so neither needs a
# restart. A new binary or a config change does: `systemctl restart
# iplookup` (a few seconds; the data files are already on disk, so it
# starts listening again at once).

[Unit]
Description=iplookup IP lookup service
Documentation=https://github.com/Doublefire-Chen/iplookup/blob/main/deploy/README.md
# The first start downloads any missing Data Source before listening.
Wants=network-online.target
After=network-online.target unbound.service

[Service]
Type=exec
User=iplookup
Group=iplookup
ExecStart=/opt/iplookup/current/iplookup -c /etc/iplookup/config.toml serve
Restart=on-failure
RestartSec=5s
# SIGTERM triggers a graceful shutdown (in-flight requests finish).
TimeoutStopSec=30s
UMask=0027

# /var/lib/iplookup, owned by iplookup and created if missing: the Data
# Source files ([data] dir in the config). The only writable place.
StateDirectory=iplookup
StateDirectoryMode=0750

# Hardening.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
